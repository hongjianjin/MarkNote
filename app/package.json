{
  "name": "marknote",
  "version": "1.0.0",
  "description": "MarkNote — a Markdown companion app for Microsoft OneNote (Windows)",
  "main": "./out/main/index.js",
  "author": "jinhjcn@gmail.com",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:win": "npm run build && electron-builder --win",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run"
  },
  "dependencies": {
    "dompurify": "^3.4.14",
    "markdown-it": "^14.1.0",
    "turndown": "^7.2.0"
  },
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.3.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/turndown": "^5.0.5",
    "@uiw/react-codemirror": "^4.23.7",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
